{{ 'component-av-cro.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign playable = 0
  for block in section.blocks
    if block.settings.video != blank or block.settings.video_url != blank
      assign playable = playable | plus: 1
    endif
  endfor
-%}

{%- if playable > 0 or request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <section class="av-section page-width section-{{ section.id }}-padding" aria-labelledby="Heading-{{ section.id }}">
      <header class="av-section__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="av-section__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="Heading-{{ section.id }}" class="av-section__heading {{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="av-section__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>

      <ul class="av-videos">
        {%- for block in section.blocks -%}
          {%- assign has_video = false -%}
          {%- if block.settings.video != blank or block.settings.video_url != blank -%}
            {%- assign has_video = true -%}
          {%- endif -%}
          {%- if has_video or request.design_mode -%}
            <li class="av-video" {{ block.shopify_attributes }}>
              <div class="av-video__frame">
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '540x',
                      controls: true,
                      playsinline: true,
                      preload: 'none',
                      class: 'av-video__player',
                      poster: block.settings.poster | image_url: width: 540
                  }}
                {%- elsif block.settings.video_url != blank -%}
                  <video
                    class="av-video__player"
                    controls
                    playsinline
                    preload="none"
                    {% if block.settings.poster != blank %}
                      poster="{{ block.settings.poster | image_url: width: 540 }}"
                    {% endif %}
                    src="{{ block.settings.video_url }}"
                  ></video>
                {%- else -%}
                  <div class="av-video__placeholder">Subí un video o pegá su enlace en este bloque</div>
                {%- endif -%}
              </div>
              <p>
                {%- if block.settings.name != blank -%}
                  <span class="av-video__name">{{ block.settings.name }}</span>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <span class="av-video__caption">{{ block.settings.caption }}</span>
                {%- endif -%}
              </p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.note != blank -%}
        <p class="av-section__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </section>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "AV · Videos testimonios",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "En sus palabras" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Escuchalos contar su experiencia" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Mediano" },
        { "value": "h1", "label": "Grande" },
        { "value": "h0", "label": "Extra grande" }
      ],
      "default": "h2"
    },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Audios reales de clientes que nos contaron cómo les fue con su rutina." },
    { "type": "textarea", "id": "note", "label": "Nota al pie", "default": "Experiencias individuales. Los resultados pueden variar de una persona a otra." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio superior", "default": 44 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio inferior", "default": 44 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video de Shopify", "info": "Subilo desde Contenido > Archivos o directamente acá." },
        { "type": "url", "id": "video_url", "label": "Enlace directo a un .mp4", "info": "Solo si no usás el video de Shopify." },
        { "type": "image_picker", "id": "poster", "label": "Imagen de portada" },
        { "type": "text", "id": "name", "label": "Nombre" },
        { "type": "text", "id": "caption", "label": "Detalle" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "AV · Videos testimonios",
      "blocks": [{ "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
