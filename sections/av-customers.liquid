{{ 'component-av-cro.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <section class="av-section page-width section-{{ section.id }}-padding" aria-labelledby="Heading-{{ section.id }}">
    <header class="av-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="av-section__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 id="Heading-{{ section.id }}" class="av-section__heading {{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="av-section__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="av-customers">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <figure class="av-customer">
              {% render 'av-image',
                image: block.settings.image,
                asset: block.settings.theme_image,
                alt: block.settings.alt,
                sizes: '(min-width: 750px) 320px, 45vw',
                cover: true
              %}
              {%- if block.settings.caption != blank -%}
                <figcaption class="av-customer__caption">{{ block.settings.caption }}</figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <p class="av-section__note">
        <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
      </p>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "AV · Clientes satisfechos",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Comunidad Alquimia Vita" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Clientes que ya recibieron su pedido" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Mediano" },
        { "value": "h1", "label": "Grande" },
        { "value": "h0", "label": "Extra grande" }
      ],
      "default": "h2"
    },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Entregamos cada pedido con el mismo cuidado con el que lo preparamos." },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio superior", "default": 44 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espacio inferior", "default": 44 }
  ],
  "blocks": [
    {
      "type": "customer",
      "name": "Cliente",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto", "info": "Si subís una foto, reemplaza a la incluida en el tema." },
        {
          "type": "select",
          "id": "theme_image",
          "label": "Foto incluida en el tema",
          "options": [
            { "value": "none", "label": "Ninguna" },
            { "value": "entrega-1", "label": "Entrega 1" },
            { "value": "entrega-2", "label": "Entrega 2" },
            { "value": "entrega-3", "label": "Entrega 3" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "alt", "label": "Texto alternativo", "default": "Cliente de Alquimia Vita con su pedido" },
        { "type": "text", "id": "caption", "label": "Epígrafe" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "AV · Clientes satisfechos",
      "blocks": [{ "type": "customer" }, { "type": "customer" }, { "type": "customer" }]
    }
  ]
}
{% endschema %}
